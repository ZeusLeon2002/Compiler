    "literals": {
        "integer": {
            "decimal": "0|[1-9][0-9]*",
            "octal": "0[0-7]+",
            "hexadecimal": "0[xX][0-9a-fA-F]+",
            "binary": "0[bB][01]+"
        },

        "floating_point": {
            "decimal": "[0-9]+\\.[0-9]*([eE][+-]?[0-9]+)?",
            "scientific": "[0-9]+([eE][+-]?[0-9]+)",
            "hexadecimal": "0[xX][0-9a-fA-F]+\\.[0-9a-fA-F]*([pP][+-]?[0-9]+)?"
        },

        "character": [
            "'a'",
            "'b'",
            "'\\n'",
            "'\\t'",
            "'\\0'",
            "'\\''",
            "'\\\\'"
        ],

        "string": [
            "\"hello\"",
            "\"Hello World\"",
            "\"Line\\nBreak\""
        ],

        "boolean": [
            "true",
            "false"
        ],

        "null_pointer": [
            "NULL"
        ]
    },

    "literal_suffixes": {
